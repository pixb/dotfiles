[user]
	email = tpxsky@163.com
	name = pix
[core]
	editor = vim
	whitespace = fix, -indent-with-non-tab, trailing-space, cr-at-eol
	excludesfile=/home/pix/.config/git/gitignore_global
	autocrlf = input
[init]
  defaultBranch = main
[alias]
    rm="rebase master"
    dc="diff --cached"
    dm="diff master"
    s="status -s"
    cm="commit -m"
    po="push origin"
    pom="push origin master"
    rebase2="rebase -i HEAD~~"
    lg = log --graph --all --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(bold white)— %an%C(reset)%C(bold yellow)%d%C(reset)' --abbrev-commit --date=relative
    co="clone"
    a="add"
[color]
	ui = auto
[color "branch"]
	current = yellow bold
	local = green bold
	remote = cyan bold
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red bold
	new = green bold
	whitespace = red reverse
[color "status"]
	added = green bold
	changed = yellow bold
	untracked = red bold
[diff]
tool = vimdiff
[difftool "vimdiff"]
prompt = false
cmd = /usr/bin/nvim -d $LOCAL $REMOTE
[merge]
tool = nvimdiff
[mergetool "nvimdiff"]
  trustExitCode = true  # 可选：信任 nvim 退出码（:cq 退出则视为失败）
  keepBackup = false
[safe]
	directory = /work/docker/docker-prometheus
[http]
	postBuffer = 524288000
[commit]
	template = /home/pix/.config/git/gitmessage
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
