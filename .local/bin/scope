#!/usr/bin/sh
# @author nate zhou
# @since 2025,2026
# general file previewer for LF & FZF
# `~/.local/bin/fzf-scope` is a modified version of my `lf/scope`

## save a cache file for faster preview
[ -d "$HOME/.cache/lf" ] || mkdir "$HOME/.cache/lf"

cell_px(){
    # Pixels per terminal cell. In lf's previewer stdout is redirected to the
    # preview file, so the window-size ioctl fails on fd 1: try fd 2, then /dev/tty.
    # foot and xterm report per-cell pixels in TIOCGWINSZ x/y while other
    # terminals report total pixels, so dividing by rows and columns
    # unconditionally gives 12/80 = 0 on foot and chafa prints nothing for -s 0x0.
    python3 -c '
import fcntl,termios,struct,os
def q(fd):
    return struct.unpack("hhhh", fcntl.ioctl(fd, termios.TIOCGWINSZ, b"\0"*8))
try:
    r, c, x, y = q(2)
except OSError:
    try:
        fd = os.open("/dev/tty", os.O_RDONLY)
        r, c, x, y = q(fd)
        os.close(fd)
    except OSError:
        print(12, 28)
        raise SystemExit
cw = x / c if c > 0 and x >= 2 * c else x
ch = y / r if r > 0 and y >= 2 * r else y
cw = int(cw) if cw >= 4 else 8
ch = int(ch) if ch >= 6 else 16
print(min(cw, 40), min(ch, 60))' 2>/dev/null || echo "12 28"
}

# -c full makes chafa build a per-image dynamic palette (226 colours measured),
# while -c 256 is the fixed DEC 256 cube, which reduces a gradient to 49 colours
# and a visible block grid.
# chafa's -s is an ASCII cell count, so the target pixel box is cells * cell
# pixels, where the cell pixels come from the terminal answering XTWINOPS.
# In a herdr pane that is the pane's own cell grid and the relay repaints in
# outer-terminal cells, so sizing by the pane geometry can only come out
# smaller, never overflowing the preview area.
# The relay budget is 1,000,000 target pixels
# (src/kitty_graphics/sixel_surface.rs) and a frame above it is dropped whole.
# Chafa maps one source pixel to one cell, so requesting more cells than the
# source has pixels upscales a small image into mosaic blocks (a 24x12 image
# stretched across 720 px). A direct foot terminal does not upscale, so match
# it here.
# Source pixel dimensions: identify can fail inside a pane (PATH, policy), so
# fall back to python PIL and then magick.
is_dims(){
    set -- $1
    [ "$#" -eq 2 ] || return 1
    case "$1$2" in
        *[!0-9]*) return 1 ;;
    esac
    [ "$1" -gt 0 ] && [ "$2" -gt 0 ]
}

src_dims(){
    D=$(identify -format '%w %h' -- "$1" 2>/dev/null); M=identify
    is_dims "$D" || {
        D=$(python3 - "$1" 2>/dev/null <<'PY'
import sys
try:
    from PIL import Image
    im = Image.open(sys.argv[1])
    print(im.size[0], im.size[1])
except Exception:
    pass
PY
); M=python3-PIL
    }
    is_dims "$D" || { D=$(/usr/bin/magick identify -format '%w %h' -- "$1" 2>/dev/null); M=magick; }
    is_dims "$D" || { D=""; M=none; }
    printf '%s' "$D"
}
sixel_cells(){
    CELLS=$(cell_px); CW=${CELLS% *}; CH=${CELLS#* }
    DIMS=$(src_dims "$3"); SW=${DIMS% *}; SH=${DIMS#* }
    S=$(awk -v cols="$1" -v rows="$2" -v cw="$CW" -v ch="$CH" -v sw="$SW" -v sh="$SH" -v maxpx=1000000 '
        BEGIN{
            # Each chafa sixel ASCII cell is cw wide and ch/2 tall (a 12x28 cell yields 12x14 px).
            hh = ch / 2;
            w = cols * cw; h = rows * ch;
            if (w * h > maxpx) { s = sqrt(maxpx / (w * h)); w = int(w * s); h = int(h * s) }
            A = int(w / cw); if (A < 1) A = 1
            B = int(h / ch); if (B < 1) B = 1
            # Do not upscale a small source past its own pixel dimensions.
            if (sw + 0 > 0 && A > sw + 0) A = sw + 0
            if (sh + 0 > 0 && B > sh + 0) B = sh + 0
            # The target pixel box must keep the source aspect ratio: rectangular pixels turn every diagonal into a staircase.
            if (sw + 0 > 0 && sh + 0 > 0) {
                a = A; b = int((a * cw * (sh + 0)) / ((sw + 0) * hh) + 0.5)
                if (b > B) { b = B; a = int((b * hh * (sw + 0)) / ((sh + 0) * cw) + 0.5) }
                if (b < 1) b = 1
            } else { a = A; b = B }
            if (a < 1) a = 1
            printf "%dx%d", a, b
        }')
    printf '%s' "$S"
}
# Walk the ancestor chain looking for herdr: the previewer's direct parent is lf
# and herdr sits above it, and a restored or attached pane may define neither
# HERDR_ENV nor TERM_PROGRAM, so the environment alone is not enough.
in_herdr(){
    p=$PPID
    i=0
    while [ "$i" -lt 8 ]; do
        [ -z "$p" ] && break
        [ "$p" -le 1 ] && break
        c=$(ps -o comm= -p "$p" 2>/dev/null)
        case "$c" in *herdr*) return 0 ;; esac
        p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
        i=$((i + 1))
    done
    return 1
}

show_img(){
    # lf passes the preview area as a cell count in $2/$3.
    # Note that lf caches only the previewer's stdout as preview text, so a
    # graphics protocol written to stdout is textualized (ESC becomes U+FFFD).
    # 1. nested environments (fzf, nvim, dvtm): ANSI colour blocks
    if [ -n "$FZF_LEVEL" ] || [ -n "$NVIM" ] || [ -n "$DVTM" ]; then
        catimg -t -w 80 "$1"
        # 2. herdr: Sixel. Herdr decodes the Sixel in the pane output and
        #    repaints it for the outer terminal's capabilities, so with
        #    terminal.host_graphics = "sixel" the outer foot renders it directly.
        #    Chafa's kitty backend declares a header size that disagrees with its
        #    payload, which strict receivers discard, so the frame goes through
        #    the herdr Sixel relay instead.
    elif [ -n "$HERDR_ENV" ] || [ "$TERM_PROGRAM" = "herdr" ] || in_herdr; then
        # Sizing is in sixel_cells: a 20x10 request in an 8x19 pane cell grid is
        # 160x190 px, so -s 16x19 paints exactly 160x190 px.
        # Sixel has no erase control, so text printed after an image overwrites
        # it: the normal path emits only the image and a placeholder text line
        # appears only when chafa fails.
        /usr/bin/chafa -f sixel \
                       -s "$(sixel_cells "$2" "$3" "$1")" \
                       --animate off \
                       --polite off \
                       --dither none \
                       -c full \
                       "$1" \
            || printf 'image %.120s\n' "$(basename "$1")"
    # 3. native foot terminal: Sixel on stdout, rendered by the terminal itself.
    #    The sizing policy is shared with the herdr branch: the cell count comes
    #    from the terminal's real cell pixels and the source aspect ratio, so
    #    output pixels stay square. in_herdr() can miss a pane (setsid breaks the
    #    ancestor chain and a restored pane has no HERDR_ENV), so both branches
    #    must apply the same policy; otherwise a pane takes this branch and
    #    scales lf's cell count directly as chafa cells.
    elif [ "$XDG_SESSION_TYPE" != "tty" ] && [ "$TERM" = "foot" ]; then
        /usr/bin/chafa -f sixel \
                       -s "$(sixel_cells "$2" "$3" "$1")" \
                       --animate off \
                       --polite on \
                       -t 1 \
                       --bg '#111111' \
                       -c full \
                       --dither none \
                       "$1"
    # 4. fallback: ANSI colour blocks
    else
        catimg -t -w "$(($2 * 2))" "$1"
    fi
}


case "$(file -Lb --mime-type -- "$1")" in
    image/*xcf|image/heic|image/x-xpixmap)
        # create a cache for every file, if 2 files have the same
        # size+name+last_modified_date, it has the same hash
        # xxhsum is faster than cryptographic hash algorithm like md5sum/shasum
        CACHE="$HOME/.cache/lf/$(stat --printf '%s%n%Y' "$(readlink -f "$1")" \
                               | xxh3sum | cut -d' ' -f1)"
        [ -f "${CACHE}.jpg" ] || convert "$1" -flatten \
                                              -quality 50 "${CACHE}.jpg"
        show_img "${CACHE}.jpg" "$2" "$3"
        ;;
    image/*)
        show_img "$1" "$2" "$3"
        ;;
    video/*)
        CACHE="$HOME/.cache/lf/$(stat --printf '%s%n%Y' "$(readlink -f "$1")" \
                               | xxh3sum | cut -d' ' -f1)"
        [ -f "${CACHE}.jpg" ] \
            || /usr/bin/ffmpegthumbnailer -i "$1" -s 480 -q 5 -o "${CACHE}.jpg"
        show_img "${CACHE}.jpg" "$2" "$3"
        ;;
    audio/*)
        mid3v2 -l "$1"
        ;;
    font/ttf)
        CACHE="$HOME/.cache/lf/$(stat --printf '%s%n%Y' "$(readlink -f "$1")" \
                               | xxh3sum | cut -d' ' -f1)"
        [ -f "${CACHE}.jpg" ] \
            || /usr/bin/convert -background none -fill white "$1" "${CACHE}.jpg"
        show_img "${CACHE}.jpg" "$2" "$3"
        ;;
    application/epub+zip)
        CACHE="$HOME/.cache/lf/$(stat --printf '%s%n%Y' "$(readlink -f "$1")" \
                               | xxh3sum | cut -d' ' -f1)"
        [ -f "${CACHE}.png" ] \
            || /usr/bin/gnome-epub-thumbnailer "$1" "$CACHE".png
        show_img "$CACHE".png "$2" "$3"
        ;;
    application/pdf)
        CACHE="$HOME/.cache/lf/$(stat --printf '%s%n%Y' "$(readlink -f "$1")" \
                               | xxh3sum | cut -d' ' -f1)"
        # `pdftoppm` already adds `.jpg` extension, don't duplicate
        [ -f "${CACHE}.jpg" ] \
            || /usr/bin/pdftoppm -f 1 -l 1 -singlefile -jpeg "$1" "$CACHE"
        show_img "$CACHE".jpg "$2" "$3"
        ;;
    application/zip|application/vnd.android.package-archive)
        zipinfo "$1" | "$PAGER"
        ;;
    application/gzip)
        case "$1" in
            *tar.gz)
                tar vvtf "$1" | "$PAGER"
                ;;
            *)
                zless "$1" | "$PAGER"
            ;;
        esac
        ;;
    application/x-7z-compressed)
        7z l -ba "$1" | grep -oP '\S+$' | "$PAGER"
        ;;
    application/*tar|application/*zip*|application/zstd|application/*xz)
        tar vvtf "$1" | "$PAGER"
        ;;
    application/vnd.rar)
        unrar-free -t "$1" | tail +8 | "$PAGER"
        ;;
    application/x-bittorrent)
        /usr/bin/transmission-show "$1" | "$PAGER"
        ;;
    application/x-iso*)
        # `iso-info` command from `libcdio`
        iso-info --no-header "$1" | tail +2 | "$PAGER"
        ;;
    application/*opendocument*)
        odt2txt "$1";
        ;;
    application/octet-stream)
        file -b "$1"
        ;;
    message/rfc822)
        "$PAGER" "$1"
        ;;
    text/troff)
        man -l "$1"
        ;;
    text/html)
        case "$1" in
            *svg)
                show_img "$1" "$2" "$3"
                ;;
            *)
                firejail --net=none w3m "$1"
                ;;
        esac
        ;;
    text/*|application/pgp-signature|application/pgp-keys|application/javascript|application/json|application/mbox)
        case "$1" in
            *svg)
                show_img "$1" "$2" "$3"
                ;;
            *)
                bat "$1"
                ;;
        esac
        ;;
    inode/directory)
        command du -aLhd1 "$1" 2> /dev/null | sort -rh
        ;;
esac
