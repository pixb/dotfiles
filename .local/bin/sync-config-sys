#!/usr/bin/env bash
# sync-config-sys
# back up live system config into ~/Documents/sys with relative paths (rsync -R)
# @author nate zhou
# @since 2024,2025
# @adapted 2026-09-27 for pix: heart -> ~/Documents/sys, list pruned to
#          paths existing on this machine

TARGET="$HOME/Documents/sys"

read -p "Continue? (y/n): " choice
if [[ "$choice" == "y" || "$choice" == "Y" ]]; then
    mkdir -p "$TARGET"
    rsync -pLvh --progress -R \
        /etc/{mkinitcpio.conf,firejail/firecfg.config,samba/smb.conf,ssh/sshd_config,systemd/logind.conf,systemd/sleep.conf,pacman.conf,pacman.d/mirrorlist,vconsole.conf} \
        "$TARGET"/
else
    echo "aborted"
    exit 0
fi
