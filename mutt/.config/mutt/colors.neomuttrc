# vim:ft=neomuttrc
# unixchad.neomuttrc
# @author nate zhou
# @since 2025
# Based on the Neonwolf Color Scheme for NeoMutt
# Retuned for the dual foot themes: Gruvbox dark (primary) / Novel light.
# Every pair below measures >= 3:1 (WCAG) on both palettes.

# basic colors ---------------------------------------------------------

color error         bold  color0    color3    # message line error text (black on yellow)
color tilde               color8    default   # vi-like tildes marking blank lines
color message             color0    color14
color markers       bold  green     color0    # wrapped-line /^\+/ markers
color attachment    bold  color0    color3    # attachment headers (black on yellow)
color search              color0    color14   # search patterns in pager
color status              color0    color14
color indicator           color0    color14   # selected email in index
color tree          bold  color9    default   # arrow in threads (`-->')

color index               color12   default ~N # new
color index               color9    default ~D # delete
color index               color0    color3   ~F # flagged (black on yellow)
color index               color5    default ~T # tagged

color index_number        color8    default
color index_author        color12   default
color index_size          default   default
color index_subject       color12   default

# keep the whole ~F row black-on-yellow (fields would otherwise keep their
# own fg on the yellow bg and drop below 3:1 in dark)
color index_number        color0    color3   ~F
color index_author        color0    color3   ~F
color index_size          color0    color3   ~F
color index_subject       color0    color3   ~F

color sidebar_new         color12   default
color sidebar_flagged     color0    color3

# message headers ------------------------------------------------------

color hdrdefault          default   default
color header              default   default     "^(Date)"
color header              color0    color14     "^(Subject)"

# body -----------------------------------------------------------------


color body         color8        default "^> \.*" # markdown quoted
color body         color8        default "^(\t| )*(-|\\*) \.*" # markdown list

color quoted             default   default
color quoted1            default   default
color quoted2            default   default
color quoted3            default   default
color quoted4            default   default
color signature          default   default     # everything below /^--\s*$/

color bold          bold default   default
color underline          default   default
color normal             default   default

color body              color5    default [\-\.+_a-zA-Z0-9]+@[\-\.a-zA-Z0-9]+ # email addr
color body              color12   default (https?|ftp)://[\-\.,/%~_:?&=\#a-zA-Z0-9@]+ # URL

## pgp

color body               color9    default    "(BAD signature)"
color body          bold color0    color2     "(Good signature)"
color body          bold color0    color2     "^gpg: Good signature .*"
color body          bold color8    default    "^gpg: "
color body          bold color9    default    "^gpg: BAD signature from.*"
mono  body          bold                        "^gpg: Good signature"
mono  body          bold                        "^gpg: BAD signature from.*"
