[Unit]
Description=ComfyUI - AI Image Generation
After=network.target

[Service]
Type=simple
User=pix
WorkingDirectory=/home/pix/work/ComfyUI
ExecStart=/home/pix/work/ComfyUI/.venv/bin/python main.py --listen 0.0.0.0 --port 8188 --enable-manager
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=CUDA_CACHE_PATH=/home/pix/.cache/nv
Environment=TRITON_CACHE_DIR=/home/pix/.cache/triton

[Install]
WantedBy=multi-user.target
