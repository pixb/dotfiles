# vim:ft=dosini
# foot/colors-light.ini
# @author pix
# @since 2026

[colors-light]
# Gruvbox 
alpha=1
background=fbf1c3  #fbf1c3
foreground=3c3836  #3c3836  
flash=7f7fee #7f7fee
flash-alpha=0.8

# 基础16色（Gruvbox Dark调色板）
# black
regular0=282828 #282828
# red
regular1=cc241d #cc241d
# green
regular2=98971a #98971a 
# yellow
regular3=d79921 #d79921 
# blue
regular4=458588 #458588 
# magenta
regular5=b16286 #b16286 
# cyan
regular6=689d6a #689d6a
# white
regular7=a89984 #a89984

# bright black
bright0=928374 #928374 
# bright red
bright1=fb4934 #fb4934 
# bright green
bright2=b8bb26 #b8bb26 
# bright yellow
bright3=fabd2f #fabd2f 
# bright blue
bright4=83a598 #83a598
# bright magenta
bright5=d3869b #d3869b
# bright cyan
bright6=8ec07c #8ec07c
# bright white
bright7=ebdbb2 #ebdbb2

# 选中文本颜色
selection-foreground=ebdbb2 #ebdbb2 
# 选中背景色
selection-background=458588 #458588 
# 滚动指示器
scrollback-indicator=242424 005577  #242424  #005577
