__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
venv/
env/
.env
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Go telemetry
go/.config/go/telemetry/

# uv binaries (installed by arch_install_user.sh)
.local/bin/uv
.local/bin/uvx
.local/bin/env
.local/bin/env.fish

# uv tool shims (modelscope-hub, generated by `uv tool install`)
.local/bin/modelscope
.local/bin/modelscope-hub
.local/bin/ms
.local/bin/ms-hub

# mpd music library (only track .mpdignore)
mus/*
!mus/.mpdignore

# newsboat local config (copied from *.example by arch_install_user.sh)
newsboat/.config/newsboat/urls
newsboat/.config/newsboat/proxy.conf

# Local runtime data (created by stow --no-folding .local package)
zsh/.local/bin/
zsh/.local/share/
zsh/.local/state/

# fcitx5 运行时生成的输入法缓存
fcitx5/.config/fcitx5/conf/cached_layouts

# herdr 运行时生成的文件 (config.toml 是手写配置，仍需跟踪)
herdr/.config/herdr/.plugins.lock
herdr/.config/herdr/herdr-client.log
herdr/.config/herdr/herdr-server.log
herdr/.config/herdr/herdr.sock.agent
herdr/.config/herdr/session-snapshots/
herdr/.config/herdr/session.json
